# macOS
.DS_Store

# Claude Code hook runtime state (not configuration — .claude/settings.json
# and .claude/hooks/ themselves ARE committed)
.claude/.skill-markers/

# Original requirement docs (not tracked in git)
docs/*
# ...except ADRs (Architecture Decision Records), which are project history
!docs/decisions/

# Editors
.vscode/
.idea/
*.swp

# Environment / secrets
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
out/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Django
db.sqlite3
staticfiles/
media/

# Java
*.class
target/

# Logs
*.log
logs/
