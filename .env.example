# Production (Task 24d): SECRET_KEY must be a real random value (never this placeholder --
# settings.py refuses to start with it outside DEBUG), DEBUG=False, and ALLOWED_HOSTS should list
# the real production domain(s), e.g. "bancostore.com,www.bancostore.com".
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to SQLite locally. Production (Task 24d) uses a mysql:// URL pointing at the VPS's
# local MySQL, e.g. mysql://bancostore:<password>@127.0.0.1:3306/bancostore
# (see SPEC.md Local dev environment).
DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Gmail SMTP for password-reset emails. Leave both blank locally to use the console
# backend instead (emails print to the terminal, no real credentials needed).
# EMAIL_HOST_PASSWORD must be a Gmail "app password", not your normal Gmail password.
# DEFAULT_FROM_EMAIL should match EMAIL_HOST_USER exactly -- that's the only address with real
# SPF/DKIM alignment for this Gmail-SMTP setup, so a mismatched address (e.g. a bancostore.com one
# with no mail-sending DNS records of its own) risks bouncing or landing in spam.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# mNotify for distributor OTP (registration, phone verification, password reset).
# Leave blank locally to use a fake sender instead (OTP codes print to the terminal,
# no real credit spent). Real sends cost money from the mNotify account balance.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Bancostore

# Paystack for registration fee / starter pack payments (Task 10). Use TEST mode
# keys (from the Paystack dashboard) for local dev -- never the live secret key.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Didit for distributor KYC verification (ID + selfie face-match/liveness, Task 11).
# DIDIT_WORKFLOW_ID comes from a workflow created in Didit's dashboard bundling
# ID Verification + Face Match + Liveness. DIDIT_WEBHOOK_SECRET verifies the
# HMAC-SHA256 signature on incoming webhook requests.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=

# hCaptcha for the public contact form's bot/spam protection. Get a site key + secret key
# from https://dashboard.hcaptcha.com (free tier). Leave both blank locally to disable the
# CAPTCHA entirely -- the widget won't render and submissions aren't checked.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
